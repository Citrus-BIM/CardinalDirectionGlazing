<Window x:Class="CardinalDirectionGlazing.CardinalDirectionGlazingWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Остекление по сторонам"
        SizeToContent="WidthAndHeight"
        MinHeight="440"
        MinWidth="680"
        MaxHeight="760"
        MaxWidth="820"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Icon="Resources/citrus.ico"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown"
        FontFamily="{DynamicResource BaseFont}"
        FontSize="{DynamicResource FontSizeBase}"
        Foreground="{DynamicResource TextBrush}"
        Background="{DynamicResource PageBgBrush}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Language="ru-RU">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CitrusTheme/CitrusTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="CompactGroupBox"
                   TargetType="GroupBox"
                   BasedOn="{StaticResource {x:Type GroupBox}}">
                <Setter Property="Margin" Value="0,0,0,12"/>
                <Setter Property="Padding" Value="10"/>
            </Style>

            <Style x:Key="SectionHint" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="OptionRadioButton"
                   TargetType="RadioButton"
                   BasedOn="{StaticResource {x:Type RadioButton}}">
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="MinHeight" Value="28"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <Style x:Key="InlineOptionRadioButton"
                   TargetType="RadioButton"
                   BasedOn="{StaticResource OptionRadioButton}">
                <Setter Property="Margin" Value="0,0,16,0"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,16"
                Padding="16,12"
                Background="{DynamicResource AccentBgHoverBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CornerRadiusSmall}">
            <StackPanel>
                <TextBlock Text="Остекление по сторонам"
                           FontSize="18"
                           FontWeight="SemiBold"/>
                <TextBlock Margin="0,4,0,0"
                           Foreground="{DynamicResource SubtleTextBrush}"
                           Text="Выберите режим, область расчёта и источник остекления."/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1"
              Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0"
                  VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <GroupBox x:Name="groupBox_SpacesOrRoomsForProcessing"
                          Grid.Row="0"
                          Header="Режим расчёта"
                          Style="{StaticResource CompactGroupBox}">
                    <Grid Margin="8,6,8,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Style="{StaticResource SectionHint}"
                                   Text="Куда записывать значения."/>
                        <RadioButton x:Name="radioButton_Spaces"
                                     Grid.Row="1"
                                     Content="Пространства"
                                     GroupName="SpacesOrRooms"
                                     IsChecked="True"
                                     Style="{StaticResource OptionRadioButton}"/>
                        <RadioButton x:Name="radioButton_Rooms"
                                     Grid.Row="2"
                                     Content="Помещения"
                                     GroupName="SpacesOrRooms"
                                     Style="{StaticResource OptionRadioButton}"
                                     Margin="0"/>
                    </Grid>
                </GroupBox>

                <GroupBox x:Name="groupBox_SpacesForProcessing"
                          Grid.Row="1"
                          Header="Область расчёта"
                          Style="{StaticResource CompactGroupBox}"
                          Margin="0">
                    <Grid Margin="8,6,8,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="textBlock_ScopeHint"
                                   Grid.Row="0"
                                   Style="{StaticResource SectionHint}"
                                   Text="Выбранные или все пространства."/>
                        <RadioButton x:Name="radioButton_Selected"
                                     Grid.Row="1"
                                     Content="Выбранные"
                                     GroupName="Scope"
                                     IsChecked="True"
                                     Style="{StaticResource OptionRadioButton}"/>
                        <RadioButton x:Name="radioButton_All"
                                     Grid.Row="2"
                                     Content="Все"
                                     GroupName="Scope"
                                     Style="{StaticResource OptionRadioButton}"
                                     Margin="0"/>
                    </Grid>
                </GroupBox>
            </Grid>

            <GroupBox x:Name="groupBox_Link"
                      Grid.Column="2"
                      Header="Источник остекления"
                      Style="{StaticResource CompactGroupBox}"
                      Margin="0"
                      VerticalAlignment="Top">
                <Grid Margin="8,6,8,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="textBlock_LinkHint"
                               Grid.Row="0"
                               Style="{StaticResource SectionHint}"
                               MinHeight="20"
                               Margin="0,0,0,10"
                               Text=""/>

                    <StackPanel x:Name="panel_LinkUsageRooms"
                                Grid.Row="1"
                                Orientation="Horizontal"
                                Margin="0,0,0,12"
                                Visibility="Collapsed">
                        <RadioButton x:Name="radioButton_LinkRoomsNone"
                                     Content="Только текущий файл"
                                     GroupName="LinkUsage"
                                     IsChecked="True"
                                     Style="{StaticResource InlineOptionRadioButton}"/>
                        <RadioButton x:Name="radioButton_LinkRoomsUse"
                                     Content="Учитывать связь"
                                     GroupName="LinkUsage"
                                     Style="{StaticResource InlineOptionRadioButton}"
                                     Margin="0"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2"
                               Margin="0,0,0,8"
                               Foreground="{DynamicResource SubtleTextBrush}"
                               Text="Связанный RVT-файл"/>

                    <ListBox x:Name="listBox_RevitLinkInstance"
                             Grid.Row="3"
                             MinWidth="320"
                             Height="184"
                             SelectionMode="Single"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </GroupBox>
        </Grid>

        <GroupBox Grid.Row="2"
                  Header="Площадь остекления из параметра"
                  Style="{StaticResource CompactGroupBox}">
            <Grid Margin="8,6,8,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="checkBox_WindowAreaFromParameter"
                          Grid.Row="0"
                          Grid.Column="0"
                          Content="Окна"
                          VerticalAlignment="Center"/>
                <ComboBox x:Name="comboBox_WindowAreaParameter"
                          Grid.Row="0"
                          Grid.Column="2"
                          MinWidth="360"
                          DisplayMemberPath="DisplayName"
                          IsEnabled="{Binding IsChecked, ElementName=checkBox_WindowAreaFromParameter}"/>
                <CheckBox x:Name="checkBox_CurtainPanelAreaFromParameter"
                          Grid.Row="1"
                          Grid.Column="0"
                          Margin="0,10,0,0"
                          Content="Витражные панели"
                          VerticalAlignment="Center"/>
                <ComboBox x:Name="comboBox_CurtainPanelAreaParameter"
                          Grid.Row="1"
                          Grid.Column="2"
                          Margin="0,10,0,0"
                          MinWidth="360"
                          DisplayMemberPath="DisplayName"
                          IsEnabled="{Binding IsChecked, ElementName=checkBox_CurtainPanelAreaFromParameter}"/>
            </Grid>
        </GroupBox>

        <Border Grid.Row="3"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,14,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="btn_Ok"
                        Content="Ок"
                        MinWidth="92"
                        Margin="0,0,10,0"
                        Padding="16,7"
                        IsDefault="True"
                        Click="btn_Ok_Click"/>
                <Button x:Name="btn_Cancel"
                        Content="Отмена"
                        MinWidth="92"
                        Padding="16,7"
                        Style="{StaticResource ButtonOutline}"
                        Click="btn_Cancel_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
